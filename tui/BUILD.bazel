load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "runpod-tui",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//api:runpod",
        "//tui-kit",
        "@crates//:anyhow",
        "@crates//:crossterm",
        "@crates//:directories",
        "@crates//:dotenvy",
        "@crates//:ratatui",
        "@crates//:serde",
        "@crates//:tokio",
    ],
)
